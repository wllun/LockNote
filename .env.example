# Copy this file to .env and use the public values from Supabase Project Settings → API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key

# RevenueCat public SDK keys. Never place a RevenueCat secret API key here.
REVENUECAT_IOS_API_KEY=appl_your-public-ios-sdk-key
REVENUECAT_ANDROID_API_KEY=goog_your-public-android-sdk-key
REVENUECAT_WEB_API_KEY=rcb_your-public-web-sdk-key
# Optional: enables simulated Test Store purchases while running in Expo Go.
REVENUECAT_TEST_API_KEY=test_your-public-test-store-key
